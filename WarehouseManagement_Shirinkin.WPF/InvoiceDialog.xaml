<Window x:Class="WarehouseManagement_Shirinkin.WPF.InvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Накладная" Height="500" Width="600" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="НАКЛАДНАЯ" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource InfoBorder}" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbProducts" Grid.Column="0" Margin="0,0,10,0" DisplayMemberPath="Name" SelectedValuePath="Article"/>
                <TextBox x:Name="TxtQuantity" Grid.Column="1" Width="80" Margin="0,0,10,0" Text="1" TextAlignment="Center"/>
                <Button x:Name="BtnAddItem" Grid.Column="2" Content="Добавить" Width="100" Click="BtnAddItem_Click"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Товары в накладной:" FontWeight="Bold" Margin="0,0,0,5"/>

        <ListView x:Name="LvItems" Grid.Row="3" Margin="0,0,0,15">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Артикул" Width="80" DisplayMemberBinding="{Binding ProductArticle}"/>
                    <GridViewColumn Header="Наименование" Width="200" DisplayMemberBinding="{Binding ProductName}"/>
                    <GridViewColumn Header="Кол-во" Width="80" DisplayMemberBinding="{Binding Quantity}"/>
                    <GridViewColumn Header="Цена" Width="80" DisplayMemberBinding="{Binding Price, StringFormat={}{0:N0}₽}"/>
                    <GridViewColumn Header="Сумма" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Total, StringFormat={}{0:N0}₽}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="4" Style="{StaticResource InfoBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnConfirm" Content="Провести" Width="120" Click="BtnConfirm_Click" Background="{StaticResource SuccessBrush}"/>
                    <Button x:Name="BtnCancel" Content="Отмена" Width="100" Click="BtnCancel_Click" IsCancel="True"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Итого: " FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtTotal" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>