<Window x:Class="WarehouseManagement_Shirinkin.WPF.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="540" Width="500" 
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="15" Margin="15" Effect="{DynamicResource {x:Static SystemParameters.DropShadowKey}}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Данные о товаре" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="5,0,0,15"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование:" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ед. измерения:" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TxtUnit" Grid.Row="2" Grid.Column="1" Margin="5" Text="шт"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория:" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="CmbCategory" Grid.Row="3" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Производитель:" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="CmbManufacturer" Grid.Row="4" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Поставщик:" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="CmbSupplier" Grid.Row="5" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Цена (₽):" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TxtPrice" Grid.Row="6" Grid.Column="1" Margin="5"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Скидка (%):" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TxtDiscount" Grid.Row="7" Grid.Column="1" Margin="5" Text="0"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Остаток:" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TxtStockQuantity" Grid.Row="8" Grid.Column="1" Margin="5" Text="0"/>

            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                <Button x:Name="BtnOk" Content="Сохранить" Width="120" Height="35" Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
                <Button x:Name="BtnCancel" Content="Отмена" Width="100" Height="35" Click="BtnCancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>