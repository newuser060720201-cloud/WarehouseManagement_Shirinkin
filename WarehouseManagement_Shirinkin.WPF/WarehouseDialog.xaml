<Window x:Class="WarehouseManagement_Shirinkin.WPF.WarehouseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Склад" Height="320" Width="480" 
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="15" Margin="15" Effect="{DynamicResource {x:Static SystemParameters.DropShadowKey}}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Данные склада" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="5,0,0,15"/>

            <TextBlock Grid.Row="1" Text="Название склада:" FontSize="13" FontWeight="Bold" Margin="5,5,0,5"/>
            <TextBox x:Name="TxtWarehouseName" Grid.Row="2" Margin="5,0,5,15" Padding="8,5"/>

            <TextBlock Grid.Row="3" Text="Адрес:" FontSize="13" FontWeight="Bold" Margin="5,5,0,5"/>
            <TextBox x:Name="TxtWarehouseAddress" Grid.Row="4" Margin="5,0,5,15" Padding="8,5"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="BtnOk" Content="Сохранить" Width="120" Height="35" Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
                <Button x:Name="BtnCancel" Content="Отмена" Width="100" Height="35" Click="BtnCancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>