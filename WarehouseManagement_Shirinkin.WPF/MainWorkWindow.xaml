<Window x:Class="WarehouseManagement_Shirinkin.WPF.MainWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление складом" Height="750" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Новая верхняя панель (изумрудная) -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Организация: " FontWeight="Bold" FontSize="14" Foreground="White"/>
                <TextBlock x:Name="TxtOrgName" Foreground="White" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text=" | Склад: " FontWeight="Bold" FontSize="14" Foreground="White" Margin="20,0,0,0"/>
                <TextBlock x:Name="TxtWarehouseName" Text="[не выбран]" Foreground="#D1FAE5" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="🏢 Управление складами" FontSize="14" FontWeight="SemiBold">
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="15" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="BtnAddWarehouse" Content="➕ Добавить склад" Width="160" Click="BtnAddWarehouse_Click"/>
                            <Button x:Name="BtnEditWarehouse" Content="✏️ Изменить" Width="120" Click="BtnEditWarehouse_Click"/>
                            <Button x:Name="BtnDeleteWarehouse" Background="{StaticResource DeleteBrush}" Content="❌ Удалить" Width="120" Click="BtnDeleteWarehouse_Click"/>
                        </StackPanel>
                        <ListView x:Name="LvWarehouses" Grid.Row="1" SelectionChanged="LvWarehouses_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Наименование склада" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Адрес" Width="400" DisplayMemberBinding="{Binding Address}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="📦 Товары на складе" FontSize="14" FontWeight="SemiBold">
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="15" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="BtnAddProduct" Content="➕ Добавить" Width="110" Click="BtnAddProduct_Click"/>
                            <Button x:Name="BtnEditProduct" Content="✏️ Изменить" Width="110" Click="BtnEditProduct_Click"/>
                            <Button x:Name="BtnDeleteProduct" Background="{StaticResource DeleteBrush}" Content="❌ Удалить" Width="110" Click="BtnDeleteProduct_Click"/>
                            <Button x:Name="BtnImport" Content="📂 Импорт" Width="110" Click="BtnImport_Click"/>
                            <Button x:Name="BtnInvoiceIn" Content="🟢 Приход" Width="110" Click="BtnInvoiceIn_Click" Background="{StaticResource SuccessBrush}"/>
                            <Button x:Name="BtnInvoiceOut" Content="🟠 Расход" Width="110" Click="BtnInvoiceOut_Click" Background="{StaticResource EditBrush}"/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource InfoBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearch" Grid.Column="0" TextChanged="TxtSearch_TextChanged" Tag="Введите название или артикул..."/>
                                <TextBlock Grid.Column="1" Text="Сортировка:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <ComboBox x:Name="CmbSort" Grid.Column="2" Width="160" SelectionChanged="CmbSort_SelectionChanged">
                                    <ComboBoxItem Content="По наименованию"/>
                                    <ComboBoxItem Content="По цене (дешевле)"/>
                                    <ComboBoxItem Content="По цене (дороже)"/>
                                    <ComboBoxItem Content="По остатку"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <ListView x:Name="LvProducts" Grid.Row="2">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Арт." Width="80" DisplayMemberBinding="{Binding Article}"/>
                                    <GridViewColumn Header="Наименование" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Категория" Width="150" DisplayMemberBinding="{Binding Category.Name}"/>
                                    <GridViewColumn Header="Цена (₽)" Width="100" DisplayMemberBinding="{Binding Price, StringFormat={}{0:N0}}"/>
                                    <GridViewColumn Header="Остаток" Width="80" DisplayMemberBinding="{Binding StockQuantity}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Новая стильная кнопка Назад -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button x:Name="BtnBack" Content="← Выход в меню" Width="200" Height="40" Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>