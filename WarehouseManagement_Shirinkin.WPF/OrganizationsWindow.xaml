<Window x:Class="WarehouseManagement_Shirinkin.WPF.OrganizationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Стартовое окно - Управление складом" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель (Меню) -->
        <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="0,20,20,0">
            <StackPanel Margin="20,40,20,20">
                <TextBlock Text="СКЛАДСКОЙ УЧЕТ" Foreground="White" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,40"/>

                <Button x:Name="BtnAdd" Content="➕ Добавить организацию" Width="210" Height="45" Margin="0,0,0,10" Background="White" Foreground="{StaticResource AccentBrush}" Click="BtnAdd_Click"/>
                <Button x:Name="BtnEdit" Content="✏️ Изменить" Width="210" Height="45" Margin="0,0,0,10" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" Click="BtnEdit_Click"/>
                <Button x:Name="BtnDelete" Content="❌ Удалить" Width="210" Height="45" Margin="0,0,0,40" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" Click="BtnDelete_Click"/>

                <Button x:Name="BtnExit" Content="Выйти из программы" Width="210" Height="45" Background="#E5E7EB" Foreground="#111827" Click="BtnExit_Click"/>
            </StackPanel>
        </Border>

        <!-- Правая панель (Список) -->
        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Список организаций" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,20"/>

                <ListView x:Name="LvOrganizations" Grid.Row="1" SelectionChanged="LvOrganizations_SelectionChanged" MouseDoubleClick="LvOrganizations_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Код" Width="80" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="Наименование" Width="350" DisplayMemberBinding="{Binding Name}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Новая стильная кнопка перехода -->
                <Button Grid.Row="2" x:Name="BtnSelect" Content="Выбрать и перейти ➡" Width="220" Height="50" HorizontalAlignment="Right" Margin="0,20,0,0" Background="{StaticResource AccentBrush}" FontSize="15" Click="BtnSelect_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>