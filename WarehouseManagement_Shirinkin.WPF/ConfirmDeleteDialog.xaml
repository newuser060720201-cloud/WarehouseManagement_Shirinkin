<Window x:Class="WarehouseManagement_Shirinkin.WPF.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение удаления" Height="350" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ВНИМАНИЕ!" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DeleteBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        <TextBlock Grid.Row="1" Text="Вы собираетесь удалить организацию." FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,15">
            Для подтверждения удаления введите название организации ниже:
        </TextBlock>

        <Border Grid.Row="3" Style="{StaticResource InfoBorder}" Margin="0,0,0,15">
            <TextBlock x:Name="TxtOrgName" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextAlignment="Center"/>
        </Border>

        <TextBox x:Name="TxtConfirmName" Grid.Row="4" Margin="0,0,0,25" FontSize="13" Padding="8,5"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnDelete" Content="Удалить" Width="120" Background="{StaticResource DeleteBrush}" Click="BtnDelete_Click" Margin="0,0,15,0"/>
            <Button x:Name="BtnCancel" Content="Отмена" Width="100" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>